{
  "description": "plainspoken hooks for Codex: the optional prompt nudge, lint + claims integrity after each apply_patch edit, the opt-in publish gate and write guard before shell commands, and the kaizen nudge at the end of a turn. Codex asks you to trust them in /hooks, and again after every plainspoken update.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/nudge.py\" --host codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/publish_gate.py\" --host codex",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/write_guard.py\" --host codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/lint_watch.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/integrity.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/kaizen_nudge.py\" --host codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
